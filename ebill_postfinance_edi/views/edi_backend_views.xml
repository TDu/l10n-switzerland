    <field name="name">edi.backend.view.view.form</field>
    <field name="inherit_id" ref="edi_oca.edi_backend_view_form" />
    <field name="arch" type="xml">
      <notebook position="inside">
        <page name="postfinance_config" string="Postfinance Service">
          <group>
            <field name="ebill_postfinance_service_id" />
          </group>
        </page>
      </notebook>
  </field>
</record>
</odoo>
